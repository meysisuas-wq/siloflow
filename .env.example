# SiloFlow Configuration
APP_NAME=SiloFlow
APP_ENV=development
APP_DEBUG=true
APP_PORT=8001
APP_SECRET_KEY=change-me

DATABASE_URL=postgresql+asyncpg://siloflow:password@localhost:5432/siloflow
DATABASE_POOL_SIZE=15

REDIS_URL=redis://localhost:6379/1

MODEL_DIR=./models
ROCM_ENABLED=false
ROCM_DEVICE_ID=0

WEATHER_API_KEY=your-weather-api-key
SATELLITE_API_KEY=your-satellite-api-key

LOG_LEVEL=INFO
